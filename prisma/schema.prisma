generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Platform ────────────────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  plan             OrgPlan  @default(FREE)
  isActive         Boolean  @default(true) @map("is_active")
  stripeCustomerId String?  @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  employees         Employee[]
  reviewCycles      ReviewCycle[]
  questionTemplates QuestionTemplate[]
  questions         Question[]
  settings          Setting[]
  allowlist         Allowlist[]
  allowedDomains    AllowedDomain[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

enum OrgPlan {
  FREE
  EXTENDED
}

// ─── Access Control ───────────────────────────────────────────────────────────

model Allowlist {
  id      String   @id @default(uuid())
  email   String
  orgId   String   @map("org_id")
  addedAt DateTime @default(now()) @map("added_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([orgId])
  @@map("allowlist")
}

model AllowedDomain {
  id      String   @id @default(uuid())
  domain  String
  orgId   String   @map("org_id")
  addedAt DateTime @default(now()) @map("added_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, domain])
  @@index([orgId])
  @@map("allowed_domains")
}

// ─── People ───────────────────────────────────────────────────────────────────

model Employee {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  name         String
  email        String
  employeeId   String?  @map("employee_id")
  department   String?
  role         String?
  isAdmin      Boolean  @default(false) @map("is_admin")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  isActive     Boolean  @default(true) @map("is_active")
  managerId    String?  @map("manager_id")
  createdAt    DateTime @default(now()) @map("created_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager       Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports Employee[]   @relation("EmployeeManager")

  reviewsAsReviewee ReviewAssignment[] @relation("AssignmentReviewee")
  reviewsAsReviewer ReviewAssignment[] @relation("AssignmentReviewer")
  responsesReceived ReviewResponse[]

  @@unique([orgId, email])
  @@unique([orgId, employeeId])
  @@index([orgId])
  @@map("employees")
}

// ─── Review Cycles ────────────────────────────────────────────────────────────

model ReviewCycle {
  id         String      @id @default(uuid())
  orgId      String      @map("org_id")
  title      String
  startDate  DateTime    @map("start_date")
  endDate    DateTime    @map("end_date")
  status     CycleStatus @default(DRAFT)
  templateId String?     @map("template_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  org            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template       QuestionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignments    ReviewAssignment[]
  responses      ReviewResponse[]
  cycleQuestions CycleQuestion[]

  @@index([orgId])
  @@map("review_cycles")
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model ReviewAssignment {
  id           String       @id @default(uuid())
  cycleId      String       @map("cycle_id")
  revieweeId   String       @map("reviewee_id")
  reviewerId   String       @map("reviewer_id")
  relationship Relationship
  submitted    Boolean      @default(false)
  submittedAt  DateTime?    @map("submitted_at")

  cycle    ReviewCycle @relation(fields: [cycleId], references: [id])
  reviewee Employee    @relation("AssignmentReviewee", fields: [revieweeId], references: [id])
  reviewer Employee    @relation("AssignmentReviewer", fields: [reviewerId], references: [id])

  @@unique([cycleId, revieweeId, reviewerId])
  @@index([cycleId, revieweeId])
  @@index([reviewerId])
  @@map("review_assignments")
}

enum Relationship {
  SELF
  MANAGER
  PEER
  DIRECT_REPORT
}

model ReviewResponse {
  id              String       @id @default(uuid())
  cycleId         String       @map("cycle_id")
  revieweeId      String       @map("reviewee_id")
  questionId      String?      @map("question_id")
  cycleQuestionId String?      @map("cycle_question_id")
  answerEncrypted String       @map("answer_encrypted")
  relationship    Relationship
  createdAt       DateTime     @default(now()) @map("created_at")

  cycle         ReviewCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewee      Employee       @relation(fields: [revieweeId], references: [id])
  question      Question?      @relation(fields: [questionId], references: [id])
  cycleQuestion CycleQuestion? @relation(fields: [cycleQuestionId], references: [id])

  @@index([cycleId, revieweeId])
  @@index([revieweeId])
  @@map("review_responses")
}

// ─── Questions ────────────────────────────────────────────────────────────────

model QuestionTemplate {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  org    Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items  QuestionTemplateItem[]
  cycles ReviewCycle[]

  @@index([orgId])
  @@map("question_templates")
}

model QuestionTemplateItem {
  id             String       @id @default(uuid())
  templateId     String       @map("template_id")
  text           String
  selfText       String?      @map("self_text")
  type           QuestionType
  ratingScale    Int?         @map("rating_scale")
  category       String
  applicableRole String?      @map("applicable_role")
  sortOrder      Int          @map("sort_order")

  template       QuestionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cycleQuestions CycleQuestion[]

  @@index([templateId, sortOrder])
  @@map("question_template_items")
}

model CycleQuestion {
  id                   String       @id @default(uuid())
  cycleId              String       @map("cycle_id")
  sourceTemplateItemId String?      @map("source_template_item_id")
  text                 String
  selfText             String?      @map("self_text")
  type                 QuestionType
  ratingScale          Int?         @map("rating_scale")
  category             String
  applicableRole       String?      @map("applicable_role")
  sortOrder            Int          @map("sort_order")

  cycle              ReviewCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  sourceTemplateItem QuestionTemplateItem? @relation(fields: [sourceTemplateItemId], references: [id], onDelete: SetNull)
  responses          ReviewResponse[]

  @@index([cycleId])
  @@map("cycle_questions")
}

model Question {
  id             String       @id @default(uuid())
  orgId          String       @map("org_id")
  text           String
  selfText       String?      @map("self_text")
  type           QuestionType
  ratingScale    Int?         @map("rating_scale")
  category       String
  applicableRole String?      @map("applicable_role")
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")

  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  responses ReviewResponse[]

  @@index([orgId, sortOrder])
  @@index([orgId])
  @@map("questions")
}

enum QuestionType {
  RATING
  OPEN_TEXT
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  actorEmail String   @map("actor_email")
  action     String
  target     String?
  metadata   String?
  createdAt  DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  key       String
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
  @@map("settings")
}
