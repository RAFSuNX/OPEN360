# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:***@localhost:5432/open360

# NextAuth session encryption secret
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Full public URL of your app
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
# Create at: https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Redirect URI to add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP email server for notifications
# Gmail example: use an App Password (not your main password)
# App passwords: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM=you@gmail.com

# AES-256 encryption key for review responses (stored encrypted in DB)
# Generate with: openssl rand -hex 32
# WARNING: changing this will make existing responses unreadable
ENCRYPTION_KEY=

# Secret token to protect cron job API endpoints
# Generate with: openssl rand -hex 16
CRON_SECRET=

# Email of the first admin user — must match their Google account
# Run: npm run bootstrap:admin   to seed this email into the database
FIRST_ADMIN_EMAIL=
